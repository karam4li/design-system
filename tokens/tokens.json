{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "The Quiet Press Tokens",
  "version": "1.1.0",
  "description": "Design system tokens infused with Anthropic computational editorial aesthetics, pigments, and navigation metrics.",
  "color": {
    "canvas": {
      "ivory": { "$value": "#faf9f5", "$type": "color" },
      "ivoryMedium": { "$value": "#f0eee6", "$type": "color" },
      "ivoryAlt": { "$value": "#f0ede4", "$type": "color" },
      "slate": { "$value": "#141413", "$type": "color" },
      "slateMedium": { "$value": "#3d3d3a", "$type": "color" },
      "slateLight": { "$value": "#5e5d59", "$type": "color" },
      "slateAlt": { "$value": "#1c1b19", "$type": "color" },
      "slateSubtle": { "$value": "#242321", "$type": "color" }
    },
    "anthropic": {
      "clay": { "$value": "#d97757", "$type": "color" },
      "accent": { "$value": "#c6613f", "$type": "color" },
      "peach": { "$value": "#ebc9b7", "$type": "color" },
      "kraft": { "$value": "#d4a27f", "$type": "color" },
      "manilla": { "$value": "#ebdbbc", "$type": "color" },
      "oat": { "$value": "#e3dacc", "$type": "color" },
      "olive": { "$value": "#788c5d", "$type": "color" },
      "cactus": { "$value": "#bcd1ca", "$type": "color" },
      "matcha": { "$value": "#ced6bf", "$type": "color" },
      "mineral": { "$value": "#629987", "$type": "color" },
      "cloud": { "$value": "#c5d3e0", "$type": "color" },
      "cloudLight": { "$value": "#d1cfc5", "$type": "color" },
      "cloudMedium": { "$value": "#b0aea5", "$type": "color" },
      "cloudDark": { "$value": "#87867f", "$type": "color" },
      "coral": { "$value": "#ebcece", "$type": "color" },
      "fig": { "$value": "#c46686", "$type": "color" },
      "orchid": { "$value": "#e5cada", "$type": "color" },
      "plum": { "$value": "#827dbd", "$type": "color" },
      "poppy": { "$value": "#de6262", "$type": "color" },
      "pencil": { "$value": "#f0ac54", "$type": "color" }
    },
    "accent": {
      "sky": { "$value": "#0284c7", "$type": "color" },
      "skyHover": { "$value": "#0369a1", "$type": "color" },
      "skySubtle": { "$value": "rgba(2, 132, 199, 0.12)", "$type": "color" },
      "skyDark": { "$value": "#38bdf8", "$type": "color" },
      "sage": { "$value": "#788c5d", "$type": "color" },
      "blue": { "$value": "#6a9bcc", "$type": "color" },
      "amber": { "$value": "#d4973b", "$type": "color" },
      "crimson": { "$value": "#c2534a", "$type": "color" }
    },
    "neutral": {
      "borderLight": { "$value": "#e8e6dc", "$type": "color" },
      "borderDark": { "$value": "#2e2d2a", "$type": "color" },
      "textMutedLight": { "$value": "#737168", "$type": "color" },
      "textMutedDark": { "$value": "#b0aea5", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "serif": {
        "$value": ["Newsreader", "Tiempos Text", "Georgia", "serif"],
        "$type": "fontFamily"
      },
      "sans": {
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "monospace"],
        "$type": "fontFamily"
      }
    },
    "lineHeight": {
      "prose": { "$value": "1.7", "$type": "lineHeight" },
      "tight": { "$value": "1.2", "$type": "lineHeight" },
      "normal": { "$value": "1.5", "$type": "lineHeight" }
    }
  },
  "radii": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "16px", "$type": "dimension" },
    "2xl": { "$value": "20px", "$type": "dimension" },
    "dropdown": { "$value": "16px", "$type": "dimension" }
  },
  "navigation": {
    "height": { "$value": "68px", "$type": "dimension" },
    "bannerHeight": { "$value": "44px", "$type": "dimension" },
    "hamburgerThickness": { "$value": "1.5px", "$type": "dimension" },
    "hamburgerGap": { "$value": "5px", "$type": "dimension" }
  }
}
